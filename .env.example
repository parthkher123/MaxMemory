# --- Neo4j (source of truth) -------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memorypassword
NEO4J_DATABASE=neo4j

# --- Qdrant (vector index) ---------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memories
# Raise for better recall on filtered search over large tenants (16-512)
QDRANT_HNSW_EF=128

# --- Embeddings --------------------------------------------------------
# voyage | openai | hash   (hash = offline deterministic fallback, no API key)
# "openai" means any OpenAI-compatible /embeddings endpoint - see EMBEDDING_BASE_URL.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Point at another OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- LLM pipeline ------------------------------------------------------
# anthropic | openai | none
#   anthropic - Claude
#   openai    - OpenAI, or any OpenAI-compatible server via LLM_BASE_URL
#               (Ollama, Groq, OpenRouter, LM Studio, vLLM, Together, ...)
#   none      - no model; text is stored verbatim with no fact extraction
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Overrides ANTHROPIC_API_KEY / OPENAI_API_KEY for the LLM only, so
# the LLM and embeddings can use different accounts or servers.
LLM_API_KEY=
# openai provider only. A local server needs no key.
LLM_BASE_URL=https://api.openai.com/v1
# Leave the two models empty to use the provider's defaults.
# Extraction and contradiction judgement: quality matters most here.
# Default: claude-opus-5 (anthropic), gpt-4.1 (openai). Set it for other servers.
EXTRACTION_MODEL=
# The intake gate and entity disambiguation run on every episode, so they get
# a cheaper model. Default: claude-haiku-4-5 (anthropic), gpt-4.1-mini (openai).
GATE_MODEL=

# --- Ingestion ---------------------------------------------------------
# true: remember() returns an episode id immediately, a worker extracts.
# false: remember() blocks and returns the facts. Handy in tests.
INGEST_ASYNC=true
WORKER_POLL_SECONDS=2.0
OUTBOX_MAX_ATTEMPTS=8
# Retries before an episode is parked as failed.
EPISODE_MAX_ATTEMPTS=3
# A worker that dies holding a claim releases it after this long.
CLAIM_TIMEOUT_SECONDS=300

# --- Retrieval tuning --------------------------------------------------
RECALL_LIMIT=8
RRF_K=60
GRAPH_EXPANSION_HOPS=1
RECENCY_HALF_LIFE_DAYS=180

# --- Reconciliation ----------------------------------------------------
# Similarity at or above this: the same fact, reinforce rather than insert.
DEDUPE_THRESHOLD=0.95
# Similarity at or above this: possibly conflicting, ask the judge model.
CONTRADICTION_THRESHOLD=0.84
# Entity resolution: auto-merge above the first, ask the model above the second.
ENTITY_MATCH_THRESHOLD=0.93
ENTITY_AMBIGUOUS_THRESHOLD=0.85
# Facts below this confidence are flagged needs_verification.
VERIFY_THRESHOLD=0.5

# --- Scope defaults ----------------------------------------------------
# Every read and write is filtered on (user_id, app_id).
DEFAULT_USER_ID=default
DEFAULT_APP_ID=default
DEFAULT_AGENT_ID=default
